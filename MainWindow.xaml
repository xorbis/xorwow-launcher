<Window x:Class="XorWoWLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XorWoW Launcher"
        Icon="Assets/xorwow.ico"
        Width="1120" Height="720" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg0}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{StaticResource Backdrop}">
        <!-- Drifting snow behind everything -->
        <Canvas x:Name="Snow" IsHitTestVisible="False" ClipToBounds="True" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="Assets/xorwow.ico" Width="18" Height="18" />
                    <TextBlock Text="XORWOW" FontFamily="{StaticResource RuneFont}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Ice}" Margin="9,1,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleVersion" FontSize="11" Foreground="{StaticResource TextFaint}" Margin="8,1,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WinButton}" Content="&#xE921;" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" />
                    <Button x:Name="MaxButton" Style="{StaticResource WinButton}" Content="&#xE922;" Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- ============ LOGIN ============ -->
            <Grid x:Name="LoginView" Grid.Row="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" Margin="0,-30,0,0">
                    <Image Source="Assets/logo.png" Width="330" Height="330" Margin="0,0,0,-34" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.OpacityMask>
                            <RadialGradientBrush>
                                <GradientStop Color="#FF000000" Offset="0.6" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Image.OpacityMask>
                        <Image.Effect>
                            <DropShadowEffect Color="{StaticResource RuneC}" BlurRadius="60" ShadowDepth="0" Opacity="0.35" />
                        </Image.Effect>
                    </Image>
                    <Border BorderBrush="{StaticResource FrostBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource Panel}" Padding="28,24">
                        <StackPanel>
                            <TextBlock Text="Enter the realm" Style="{StaticResource H2}" FontSize="17" HorizontalAlignment="Center" Margin="0,0,0,18" />
                            <TextBlock Text="Account name" Style="{StaticResource Label}" />
                            <TextBox x:Name="UserBox" MaxLength="16" Margin="0,0,0,12" KeyDown="LoginField_KeyDown" />
                            <TextBlock Text="Password" Style="{StaticResource Label}" />
                            <PasswordBox x:Name="PassBox" MaxLength="16" Margin="0,0,0,12" KeyDown="LoginField_KeyDown" PasswordChanged="PassBox_PasswordChanged" />
                            <StackPanel x:Name="TokenPanel" Visibility="Collapsed">
                                <TextBlock Text="Authenticator code" Style="{StaticResource Label}" />
                                <TextBox x:Name="TokenBox" MaxLength="8" Margin="0,0,0,12" KeyDown="LoginField_KeyDown" />
                            </StackPanel>
                            <CheckBox x:Name="RememberBox" Content="Remember me on this PC" Margin="0,2,0,18" />
                            <Button x:Name="LoginButton" Style="{StaticResource IceButton}" Content="LOG IN" Click="Login_Click" HorizontalAlignment="Stretch" />
                            <TextBlock x:Name="LoginMessage" Foreground="{StaticResource Danger}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" MinHeight="18" />
                            <TextBlock x:Name="LoginNotice" Foreground="{StaticResource Ok}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="LoginFooter" Style="{StaticResource Dim}" FontSize="11" HorizontalAlignment="Center" Margin="0,14,0,0" Foreground="{StaticResource TextFaint}" />
                </StackPanel>
            </Grid>

            <!-- ============ MAIN ============ -->
            <Grid x:Name="MainView" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation -->
                <Border Grid.Column="0" Background="#80050B14" BorderBrush="{StaticResource Line}" BorderThickness="0,1,1,0">
                    <DockPanel>
                        <Image DockPanel.Dock="Top" Source="Assets/logo.png" Width="170" Height="170" Margin="0,6,0,10" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.OpacityMask>
                                <RadialGradientBrush>
                                    <GradientStop Color="#FF000000" Offset="0.6" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Image.OpacityMask>
                            <Image.Effect>
                                <DropShadowEffect Color="{StaticResource RuneC}" BlurRadius="30" ShadowDepth="0" Opacity="0.3" />
                            </Image.Effect>
                        </Image>
                        <StackPanel DockPanel.Dock="Bottom" Margin="22,0,22,20">
                            <TextBlock Text="Logged in as" Style="{StaticResource Label}" />
                            <TextBlock x:Name="AccountName" FontFamily="{StaticResource RuneFont}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource IceBright}" Margin="0,0,0,10" TextTrimming="CharacterEllipsis" />
                            <Button Style="{StaticResource GhostButton}" Content="Log out" Click="Logout_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel>
                            <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Content="PLAY" Tag="&#xE768;" GroupName="Nav" IsChecked="True" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavAddons" Style="{StaticResource NavItem}" Content="ADDONS" Tag="&#xEA86;" GroupName="Nav" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavNotes" Style="{StaticResource NavItem}" Content="RELEASE NOTES" Tag="&#xE7BC;" GroupName="Nav" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Content="SETTINGS" Tag="&#xE713;" GroupName="Nav" Checked="Nav_Checked" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ===== Home ===== -->
                    <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="36,26,36,24">
                            <TextBlock x:Name="WelcomeText" Style="{StaticResource H1}" Text="Welcome" />
                            <TextBlock Text="Wrath of the Lich King 3.3.5a · XorWoW realm" Style="{StaticResource Dim}" Margin="0,4,0,22" />

                            <UniformGrid Columns="3" Margin="-6,0">
                                <Border Style="{StaticResource Card}" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="REALM" Style="{StaticResource Label}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="RealmDot" Width="10" Height="10" Fill="{StaticResource Ok}" VerticalAlignment="Center" Margin="0,0,8,0" Effect="{StaticResource SoftGlow}" />
                                            <TextBlock x:Name="RealmText" Text="Online" FontSize="16" Foreground="{StaticResource IceBright}" />
                                        </StackPanel>
                                        <TextBlock x:Name="RealmAddress" Style="{StaticResource Dim}" FontSize="11" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="GAME CLIENT" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="ClientText" Text="Checking…" FontSize="16" Foreground="{StaticResource IceBright}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="ClientDetail" Style="{StaticResource Dim}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="XORWOW ADDONS" Style="{StaticResource Label}" />
                                        <TextBlock x:Name="XorAddonText" Text="–" FontSize="16" Foreground="{StaticResource IceBright}" />
                                        <TextBlock x:Name="XorAddonDetail" Style="{StaticResource Dim}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="CheckButton" Style="{StaticResource GhostButton}" Content="Check for updates" Click="Check_Click" Margin="0,0,8,8" />
                                <Button x:Name="VerifyButton" Style="{StaticResource GhostButton}" Content="Verify all game files" Click="Verify_Click" Margin="0,0,8,8" ToolTip="Hash every file again instead of trusting the cache (repairs a damaged install)" />
                                <Button Style="{StaticResource GhostButton}" Content="Open XorWoW folder" Click="OpenFolder_Click" Margin="0,0,8,8" />
                            </WrapPanel>

                            <TextBlock Text="Latest news" Style="{StaticResource H2}" Margin="0,22,0,10" />
                            <ItemsControl x:Name="NewsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource NoteCard}" Margin="0,0,0,8" Padding="16,12" MouseLeftButtonUp="Note_Click">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Foreground="{StaticResource TextFaint}" FontSize="11" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Kind}" Foreground="{StaticResource Rune}" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Body}" Style="{StaticResource Dim}" Margin="0,6,0,0" MaxHeight="58" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Visibility>
                                                        <Binding Path="HasBody" Converter="{StaticResource BoolToVis}" />
                                                    </TextBlock.Visibility>
                                                </TextBlock>
                                                <TextBlock Text="Read more ›" Foreground="{StaticResource Ice}" FontSize="11" Margin="0,6,0,0" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NewsEmpty" Text="No news yet." Style="{StaticResource Dim}" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Addons ===== -->
                    <Grid x:Name="AddonsPage" Visibility="Collapsed" Margin="36,26,36,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="TabBrowse" Style="{StaticResource Pill}" Content="Browse" GroupName="AddonTab" IsChecked="True" Checked="AddonTab_Checked" />
                                <RadioButton x:Name="TabInstalled" Style="{StaticResource Pill}" Content="Installed" GroupName="AddonTab" Checked="AddonTab_Checked" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Addons" Style="{StaticResource H1}" />
                                <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0">
                                    <Run Text="3.3.5a addons from" />
                                    <Hyperlink NavigateUri="https://warperia.com/wotlk-addons/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{StaticResource Ice}">warperia.com</Hyperlink><Run Text=", kept up to date after each game update." />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>

                        <DockPanel x:Name="BrowseBar" Grid.Row="1" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <RadioButton x:Name="SortPopular" Style="{StaticResource Pill}" Content="Most popular" GroupName="Sort" Checked="Sort_Checked" />
                                <RadioButton x:Name="SortUpdated" Style="{StaticResource Pill}" Content="Recently updated" GroupName="Sort" Checked="Sort_Checked" />
                            </StackPanel>
                            <TextBox x:Name="SearchBox" Tag="Search addons (Questie, Details, Atlas…)" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged" />
                        </DockPanel>
                        <DockPanel x:Name="InstalledBar" Grid.Row="1" Margin="0,0,0,12" Visibility="Collapsed">
                            <Button x:Name="AddonUpdateButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Check for addon updates" Click="AddonUpdates_Click" />
                            <TextBlock x:Name="InstalledSummary" Style="{StaticResource Dim}" VerticalAlignment="Center" />
                        </DockPanel>

                        <ScrollViewer x:Name="AddonScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
                            <StackPanel Margin="0,0,0,20">
                                <ItemsControl x:Name="AddonList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="44" Height="44" CornerRadius="5" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#60081322" VerticalAlignment="Top" HorizontalAlignment="Left" ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock Text="&#xEA86;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Image Source="{Binding IconImage}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource IceBright}" />
                                                            <TextBlock Text="{Binding Author}" Foreground="{StaticResource TextFaint}" FontSize="11" Margin="8,0,0,1" VerticalAlignment="Bottom" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}" Margin="0,3,0,0" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Meta}" Foreground="{StaticResource TextFaint}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="110">
                                                        <Button Style="{StaticResource GhostButton}" Content="{Binding ActionText}" IsEnabled="{Binding ActionEnabled}" Click="AddonAction_Click" Tag="{Binding}" Margin="0,0,0,4">
                                                            <Button.Visibility>
                                                                <Binding Path="HasAction" Converter="{StaticResource BoolToVis}" />
                                                            </Button.Visibility>
                                                        </Button>
                                                        <Button Style="{StaticResource DangerButton}" Content="Remove" Click="AddonRemove_Click" Tag="{Binding}" IsEnabled="{Binding ActionEnabled}">
                                                            <Button.Visibility>
                                                                <Binding Path="CanRemove" Converter="{StaticResource BoolToVis}" />
                                                            </Button.Visibility>
                                                        </Button>
                                                        <TextBlock Text="{Binding Badge}" Foreground="{StaticResource Ok}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="AddonEmpty" Style="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,20" Visibility="Collapsed" />
                                <Button x:Name="MoreButton" Style="{StaticResource GhostButton}" Content="Load more" Click="More_Click" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Release notes ===== -->
                    <Grid x:Name="NotesPage" Visibility="Collapsed" Margin="36,26,24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Release notes" Style="{StaticResource H1}" Margin="0,0,0,16" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="Server updates" Style="{StaticResource H2}" Margin="0,0,0,10" />
                                <TextBlock x:Name="ServerNotesEmpty" DockPanel.Dock="Top" Style="{StaticResource Dim}" Text="No server updates posted yet." Visibility="Collapsed" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                                    <ItemsControl x:Name="ServerNotes" Margin="0,0,0,20">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource NoteCard}" Margin="0,0,0,8" Padding="14,10" MouseLeftButtonUp="Note_Click">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding When}" Foreground="{StaticResource Rune}" FontSize="11" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                        <TextBlock Text="Read more ›" Foreground="{StaticResource Ice}" FontSize="11" Margin="0,6,0,0" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="XorWoW addon" Style="{StaticResource H2}" Margin="0,0,0,10" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                                    <ItemsControl x:Name="AddonNotes" Margin="0,0,0,20">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource NoteCard}" Margin="0,0,0,8" Padding="14,10" MouseLeftButtonUp="Note_Click">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Foreground="{StaticResource TextFaint}" FontSize="11" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource IceBright}" FontWeight="SemiBold" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Body}" Style="{StaticResource Dim}" Margin="0,6,0,0" />
                                                        <TextBlock Text="Read more ›" Foreground="{StaticResource Ice}" FontSize="11" Margin="0,6,0,0" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Grid>

                    <!-- ===== Settings ===== -->
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="36,26,36,24" MaxWidth="720" HorizontalAlignment="Left">
                            <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,20" />

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Game folder" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Open" Click="OpenFolder_Click" Margin="10,0,0,0" />
                                        <TextBlock x:Name="FolderText" Foreground="{StaticResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Dim}" FontSize="11" Margin="0,8,0,0" Text="XorWoW lives in the launcher's folder: XorWoW.exe at its root, the game in its client subfolder. To move it, move the whole folder. Updates never touch WTF, Screenshots, your own addons or your own Data patches; the launcher only removes what it put there itself, and stray files outside those folders." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Launcher" Style="{StaticResource H2}" Margin="0,0,0,10" />
                                    <CheckBox x:Name="GameLoginBox" Content="Log me into the game at Play (types the password at the game's login screen)" Margin="0,0,0,4" Click="SettingBox_Click" />
                                    <TextBlock Style="{StaticResource Dim}" FontSize="11" Margin="27,0,0,12" Text="With Remember me, this keeps your password encrypted for your Windows account, since the game needs the password itself. Off: it is not kept." />
                                    <CheckBox x:Name="CloseOnPlayBox" Content="Close the launcher when the game starts (otherwise it is minimized)" Margin="0,0,0,10" Click="SettingBox_Click" />
                                    <CheckBox x:Name="ManageAddonsBox" Content="Keep the XorWoW addons (XorWoW, HuntsUI, Transmog, Pawn) at the realm's release" Click="SettingBox_Click" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Realm address" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Save" Click="SaveServer_Click" Margin="10,0,0,0" />
                                        <TextBox x:Name="ServerBox" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Dim}" FontSize="11" Margin="0,8,0,0" Text="Only change this if the realm tells you it moved. Login goes to port 3724 of this address; game files come from dailywar.online." />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="2,6,0,0">
                                <TextBlock x:Name="AboutText" Style="{StaticResource Dim}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource LinkButton}" Content="Open log" Click="OpenLog_Click" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Notice banner (e.g. after the launcher updated itself) ===== -->
                    <Border x:Name="Toast" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,26,0" Padding="16,10"
                            CornerRadius="6" Background="{StaticResource PanelSolid}" BorderBrush="{StaticResource Ok}" BorderThickness="1"
                            Visibility="Collapsed" Effect="{StaticResource SoftGlow}" Panel.ZIndex="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Ok}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock x:Name="ToastText" Foreground="{StaticResource IceBright}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- ===== Bottom bar: progress + PLAY ===== -->
                    <Border Grid.Row="1" Background="#B0050B14" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,14,24,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <DockPanel>
                                    <TextBlock x:Name="SpeedText" DockPanel.Dock="Right" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Bottom" />
                                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource IceBright}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <ProgressBar x:Name="Bar" Margin="0,8,0,6" Maximum="1000" />
                                <DockPanel>
                                    <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Cancel" FontSize="11" Click="Cancel_Click" Visibility="Collapsed" />
                                    <TextBlock x:Name="DetailText" Foreground="{StaticResource TextFaint}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </StackPanel>
                            <Button x:Name="PlayButton" Grid.Column="1" Style="{StaticResource PlayButton}" Content="PLAY" Click="Play_Click" IsEnabled="False" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============ Release note detail (under the dialog, so a dialog still shows over it) ============ -->
        <Grid x:Name="NoteLayer" Visibility="Collapsed" Background="#C0030710" MouseLeftButtonUp="NoteLayer_Click">
            <Border x:Name="NotePanel" Width="720" Margin="0,40" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource FrostBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource PanelSolid}" Padding="28,22,18,20">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource RuneC}" BlurRadius="40" ShadowDepth="0" Opacity="0.35" />
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,10,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Close" Click="NoteClose_Click" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock x:Name="NoteKind" Foreground="{StaticResource Rune}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Name="NoteTitle" Style="{StaticResource H2}" FontSize="18" TextWrapping="Wrap" Margin="0,4,12,0" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer x:Name="NoteScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <StackPanel x:Name="NoteBody" Margin="0,10,0,0" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ Dialog overlay ============ -->
        <Grid x:Name="DialogLayer" Visibility="Collapsed" Background="#C0030710">
            <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource FrostBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource PanelSolid}" Padding="28,24">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource RuneC}" BlurRadius="40" ShadowDepth="0" Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Style="{StaticResource H2}" FontSize="17" Margin="0,0,0,12" />
                    <TextBlock x:Name="DialogText" Foreground="{StaticResource Text}" TextWrapping="Wrap" LineHeight="20" />
                    <CheckBox x:Name="DialogCheck" Margin="0,16,0,0" Visibility="Collapsed" />
                    <StackPanel x:Name="DialogButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

